# Local credentials for the transaction-limits-api stack.
# Copy this file to .env (docker compose reads .env automatically):
#     cp .env.example .env

POSTGRES_LIMITS_DB=transaction_limits_db
POSTGRES_LIMITS_USER=transaction_limits_user
POSTGRES_LIMITS_PASSWORD=limits_secret_password_123
# Host port for PostgreSQL: 5436 (5432 native, 5434 loan-simulator, 5435 fee-calculator).
POSTGRES_LIMITS_PORT=5436
# Host port for Redis: 6380 (6379 is usually taken by a native Redis).
REDIS_LIMITS_PORT=6380
